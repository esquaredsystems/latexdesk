{
  "name": "latexdesk",
  "displayName": "LaTeX Desk",
  "description": "All the LaTeX power, none of the setup, and no limits on your builds. Build, preview, fix your bibliography and export for submission, all inside Visual Studio Code.",
  "version": "0.2.1",
  "publisher": "esquaredsystems",
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#1E3A8A",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/esquaredsystems/latexdesk.git"
  },
  "bugs": {
    "url": "https://github.com/esquaredsystems/latexdesk/issues"
  },
  "homepage": "https://github.com/esquaredsystems/latexdesk#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "latex",
    "tex",
    "bibtex",
    "biblatex",
    "pdf",
    "synctex",
    "latexmk",
    "thesis",
    "arxiv",
    "academic writing"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "latexdesk-bibcheck": "./dist/bibcheck.js"
  },
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex",
    "onWebviewPanel:latexdesk.pdf"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Building, formatting with external tools and running LaTeX tools are disabled in untrusted workspaces. Completion, outline and the bibliography checker still work."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "extensions": [
          ".tex",
          ".sty",
          ".cls",
          ".ltx"
        ]
      },
      {
        "id": "bibtex",
        "extensions": [
          ".bib"
        ]
      }
    ],
    "snippets": [
      {
        "language": "latex",
        "path": "./snippets/latex.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexdesk",
          "title": "LaTeX Desk",
          "icon": "media/icon.svg"
        },
        {
          "id": "latexdesk-tools",
          "title": "LaTeX Tools",
          "icon": "media/tools-icon.svg"
        }
      ]
    },
    "views": {
      "latexdesk": [
        {
          "id": "latexdesk.build",
          "name": "Build"
        },
        {
          "id": "latexdesk.structure",
          "name": "Structure"
        },
        {
          "id": "latexdesk.files",
          "name": "Files"
        },
        {
          "id": "latexdesk.citations",
          "name": "Bibliography & Citations",
          "visibility": "collapsed"
        },
        {
          "id": "latexdesk.labels",
          "name": "Labels & References",
          "visibility": "collapsed"
        },
        {
          "id": "latexdesk.outputs",
          "name": "Output Files",
          "visibility": "collapsed"
        },
        {
          "id": "latexdesk.history",
          "name": "History",
          "visibility": "collapsed"
        }
      ],
      "latexdesk-tools": [
        {
          "type": "webview",
          "id": "latexdesk.tools",
          "name": "Format & Symbols"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "latexdesk.build",
        "contents": "No LaTeX root document found in this workspace.\n[New LaTeX Project](command:latexdesk.newProject)\n[Check LaTeX Tools](command:latexdesk.checkTools)"
      }
    ],
    "customEditors": [
      {
        "viewType": "latexdesk.bibManager",
        "displayName": "Bib Manager",
        "selector": [
          {
            "filenamePattern": "*.bib"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
