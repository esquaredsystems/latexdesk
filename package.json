        {
          "command": "latexdesk.tableWizard",
          "when": "editorLangId == latex",
          "group": "latexdesk@4"
        }
      ],
      "explorer/context": [
        {
          "command": "latexdesk.build",
          "when": "resourceExtname == .tex",
          "group": "latexdesk"
        },
        {
          "command": "latexdesk.openBibManager",
          "when": "resourceExtname == .bib",
          "group": "latexdesk"
        }
      ],
      "view/title": [
        {
          "command": "latexdesk.openDashboard",
          "when": "view == latexdesk.build",
          "group": "navigation@1"
        },
        {
          "command": "latexdesk.stopBuild",
          "when": "view == latexdesk.build && latexdesk.building",
          "group": "navigation@2"
        },
        {
          "command": "latexdesk.structureFilter",
          "when": "view == latexdesk.structure",
          "group": "navigation@1"
        },
        {
          "command": "latexdesk.refreshViews",
          "when": "view == latexdesk.structure || view == latexdesk.files || view == latexdesk.citations || view == latexdesk.labels || view == latexdesk.outputs",
          "group": "navigation@9"
        },
        {
          "command": "latexdesk.history.snapshot",
          "when": "view == latexdesk.history",
          "group": "navigation@1"
        },
        {
          "command": "latexdesk.history.label",
          "when": "view == latexdesk.history",
          "group": "navigation@2"
        },
        {
          "command": "latexdesk.history.latexdiff",
          "when": "view == latexdesk.history",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "latexdesk.revealFile",
          "when": "view == latexdesk.outputs && viewItem == outputFile",
          "group": "1@1"
        },
        {
          "command": "latexdesk.copyPath",
          "when": "view == latexdesk.outputs && viewItem == outputFile",
          "group": "1@2"
        },
        {
          "command": "latexdesk.deleteOutput",
          "when": "view == latexdesk.outputs && viewItem == outputFile",
          "group": "2@1"
        },
        {
          "command": "latexdesk.history.diff",
          "when": "view == latexdesk.history && viewItem == historySnapshot",
          "group": "inline"
        },
        {
          "command": "latexdesk.history.label",
          "when": "view == latexdesk.history && viewItem == historySnapshot",
          "group": "1@1"
        },
        {
          "command": "latexdesk.history.latexdiff",
          "when": "view == latexdesk.history && viewItem == historySnapshot",
          "group": "1@2"
        },
        {
          "command": "latexdesk.history.restoreProject",
          "when": "view == latexdesk.history && viewItem == historySnapshot",
          "group": "2@1"
        },
        {
          "command": "latexdesk.history.diff",
          "when": "view == latexdesk.history && viewItem == historyFile",
          "group": "inline"
        },
        {
          "command": "latexdesk.history.restoreFile",
          "when": "view == latexdesk.history && viewItem == historyFile",
          "group": "2@1"
        }
      ],
      "commandPalette": [
        {
          "command": "latexdesk.onEnter",
          "when": "false"
        },
        {
          "command": "latexdesk.revealFile",
          "when": "false"
        },
        {
          "command": "latexdesk.copyPath",
          "when": "false"
        },
        {
          "command": "latexdesk.deleteOutput",
          "when": "false"
        },
        {
          "command": "latexdesk.history.diff",
          "when": "false"
        },
        {
          "command": "latexdesk.history.restoreFile",
          "when": "false"
        },
        {
          "command": "latexdesk.history.restoreProject",
          "when": "false"
        },
        {
          "command": "latexdesk.history.refresh",
          "when": "false"
        },
        {
          "command": "latexdesk.spell.addWord",
          "when": "false"
        },
        {
          "command": "latexdesk.spell.ignore",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.undo",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.redo",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.cut",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.copy",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.paste",
          "when": "false"
        },
        {
          "command": "latexdesk.tb.comment",
          "when": "false"
        }
      ],
      "latexdesk.partMenu": [
        {
          "command": "latexdesk.insert.part",
          "group": "1@0"
        },
        {
          "command": "latexdesk.insert.chapter",
          "group": "1@1"
        },
        {
          "command": "latexdesk.insert.section",
          "group": "1@2"
        },
        {
          "command": "latexdesk.insert.subsection",
          "group": "1@3"
        },
        {
          "command": "latexdesk.insert.subsubsection",
          "group": "1@4"
        },
        {
          "command": "latexdesk.insert.paragraph",
          "group": "1@5"
        },
        {
          "command": "latexdesk.insert.subparagraph",
          "group": "1@6"
        }
      ],
      "latexdesk.labelMenu": [
        {
          "command": "latexdesk.insert.label",
          "group": "1@0"
        },
        {
          "command": "latexdesk.insert.ref",
          "group": "1@1"
        },
        {
          "command": "latexdesk.insert.eqref",
          "group": "1@2"
        },
        {
          "command": "latexdesk.insert.pageref",
          "group": "1@3"
        },
        {
          "command": "latexdesk.insert.cref",
          "group": "1@4"
        },
        {
          "command": "latexdesk.insert.cite",
          "group": "1@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "latexdesk.build",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.viewPdf",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.syncForward",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.stopBuild",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "latexdesk.building"
      },
      {
        "command": "latexdesk.clean",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.insertEnvironment",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.wrapEnvironment",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorLangId == latex && editorHasSelection"
      },
      {
        "command": "latexdesk.citationBrowser",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.closeEnvironment",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorLangId == latex"
      },
      {
        "command": "latexdesk.onEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == latex && !suggestWidgetVisible && !editorHasMultipleSelections && !inSnippetMode && config.latexdesk.editing.autoItem"
      },
      {
        "command": "latexdesk.buildFast",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "editorLangId == latex"
      }
    ],
    "configuration": [
      {
        "title": "Project",
        "properties": {
          "latexdesk.rootFile": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "markdownDescription": "Root document relative to the workspace folder. Leave empty to detect it automatically (magic comment `% !TEX root`, then `\\documentclass` files)."
          },
          "latexdesk.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/node_modules/**",
              "**/.git/**",
              "**/build/**",
              "**/.latexdesk/**"
            ],
            "description": "Glob patterns ignored when looking for LaTeX files."
          }
        }
      },
      {
        "title": "Build",
        "properties": {
          "latexdesk.build.autoBuild": {
            "type": "string",
            "enum": [
              "onSave",
              "never"
            ],
            "default": "onSave",
            "description": "When to build automatically."
          },
          "latexdesk.build.recipe": {
            "type": "string",
            "default": "latexmk (pdf)",
            "description": "Name of the default recipe. 'latexmk (pdf)' is used when latexmk is installed."
          },
          "latexdesk.build.outDir": {
            "type": "string",
            "default": "",
            "markdownDescription": "Output directory, relative to the root document. Supports `%DIR%` and `%DOCNAME%`. Empty means next to the root document."
          },
          "latexdesk.build.timeout": {
            "type": "number",
            "default": 600,
            "description": "Seconds before a running build is stopped."
          },
          "latexdesk.build.backupExistingPdf": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Before the first build of a root document in a session, copy an existing PDF and SyncTeX file into `.latexdesk/snapshots/` so they can be recovered."
          },
          "latexdesk.build.tools": {
            "type": "array",
            "default": [],
            "markdownDescription": "Extra tools usable in recipes: `{ \"name\": \"...\", \"command\": \"...\", \"args\": [\"%DOC%\"], \"env\": {} }`. Placeholders: `%DOC%` (root without extension), `%DOCFILE%`, `%DIR%`, `%OUTDIR%`, `%DOC_EXT%`."
          },
          "latexdesk.build.recipes": {
            "type": "array",
            "default": [],
            "markdownDescription": "Extra recipes: `{ \"name\": \"...\", \"tools\": [\"pdflatex\", \"bibtex\", \"pdflatex\"] }`. They are added to the built-in ones."
          },
          "latexdesk.build.cleanExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".aux",
              ".bbl",
              ".blg",
              ".idx",
              ".ind",
              ".ilg",
              ".lof",
              ".lot",
              ".toc",
              ".out",
              ".fls",
              ".fdb_latexmk",
              ".log",
              ".nav",
              ".snm",
              ".synctex.gz",
              ".bcf",
              ".run.xml",
              ".nlo",
              ".nls",
              ".loa",
              ".xdv",
              ".dvi"
            ],
            "description": "Extensions removed by 'Clean Auxiliary Files'. Only files named after the root document are deleted."
          },
          "latexdesk.tools.paths": {
            "type": "object",
            "default": {},
            "markdownDescription": "Explicit executable paths, for example `{ \"latexmk\": \"/Library/TeX/texbin/latexmk\" }`."
          },
          "latexdesk.errors.extra": {
            "type": "array",
            "default": [],
            "markdownDescription": "Your own error explanations, checked before the built-in ones: `{ \"id\": \"my-macro\", \"pattern\": \"regular expression\", \"title\": \"...\", \"meaning\": \"...\", \"causes\": [\"...\"], \"fix\": \"...\" }`.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "pattern",
                "title",
                "meaning",
                "fix"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "meaning": {
                  "type": "string"
                },
                "causes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fix": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      {
        "title": "PDF viewer",
        "properties": {
          "latexdesk.viewer.openAfterBuild": {
            "type": "boolean",
            "default": true,
            "description": "Open the PDF beside the source after the first successful build."
          },
          "latexdesk.viewer.syncAfterBuild": {
            "type": "boolean",
            "default": false,
            "description": "Scroll the PDF to the cursor position after each successful build."
          },
          "latexdesk.viewer.reverseSyncClick": {
            "type": "string",
            "enum": [
              "ctrl-click",
              "double-click"
            ],
            "default": "ctrl-click",
            "description": "Mouse action in the PDF that jumps to the source (Cmd-click on macOS)."
          },
          "latexdesk.viewer.theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "follow-editor"
            ],
            "default": "light",
            "description": "Page colours in the PDF viewer. 'dark' inverts the pages."
          }
        }
      },
      {
        "title": "Editing",
        "properties": {
          "latexdesk.editing.autoItem": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Pressing Enter on an `\\item` line inserts a new `\\item`. Enter on an empty `\\item` ends the list item."
          },
          "latexdesk.completion.citeCommands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "cite",
              "citep",
              "citet",
              "citealp",
              "citeauthor",
              "citeyear",
              "autocite",
              "parencite",
              "textcite",
              "footcite",
              "nocite",
              "Cite",
              "Citep",
              "Citet"
            ],
            "description": "Commands whose argument is completed with citation keys."
          },
          "latexdesk.completion.refCommands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "ref",
              "eqref",
              "pageref",
              "autoref",
              "cref",
              "Cref",
              "nameref",
              "vref"
            ],
            "description": "Commands whose argument is completed with labels."
          },
          "latexdesk.hover.math": {
            "type": "boolean",
            "default": true,
            "description": "Render math under the mouse (approximate preview, made with MathJax)."
          },
          "latexdesk.format.tool": {
            "type": "string",
            "enum": [
              "builtin",
              "latexindent",
              "tex-fmt"
            ],
            "default": "builtin",
            "description": "Formatter used by Format Document."
          },
          "latexdesk.checks.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Live checks while typing: unmatched `\\begin`/`\\end`, duplicate labels, undefined references and citations."
          }
        }
      },
      {
        "title": "Bibliography",
        "properties": {
          "latexdesk.bib.profile": {
            "type": "string",
            "enum": [
              "minimal",
              "standard",
              "strict"
            ],
            "default": "standard",
            "markdownDescription": "Which recommended fields the checker expects. `minimal`: only required fields. `standard`: also DOI/pages/volume. `strict`: submission-ready."
          },
          "latexdesk.bib.dialect": {
            "type": "string",
            "enum": [
              "auto",
              "bibtex",
              "biblatex"
            ],
            "default": "auto",
            "description": "Field rules to apply. 'auto' uses biblatex when the project loads it."
          },
          "latexdesk.bib.uncited": {
            "type": "string",
            "enum": [
              "off",
              "hint",
              "warning"
            ],
            "default": "hint",
            "description": "How entries that are never cited are reported."
          },
          "latexdesk.bib.rules": {
            "type": "object",
            "default": {},
            "markdownDescription": "Per-rule severity override, for example `{ \"bib/missing-doi\": \"off\", \"bib/placeholder-value\": \"error\" }`."
          }
        }
      },
      {
        "title": "History",
        "properties": {
          "latexdesk.history.maxSnapshots": {
            "type": "number",
            "default": 200,
            "minimum": 10,
            "markdownDescription": "Unlabelled snapshots kept in `.latexdesk/history/`. Older ones are removed first; labelled versions are always kept."
          }
        }
      },
      {
        "title": "Spelling",
        "properties": {
          "latexdesk.spell.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Check the spelling of prose in LaTeX files (commands, math, labels, citations and comments are skipped)."
          },
          "latexdesk.spell.language": {
            "type": "string",
            "default": "en_US",
            "markdownDescription": "Dictionary language, e.g. `en_US` or `en_GB` (bundled). A file can choose its own with `% !TeX spellcheck = en_GB`."
          },
          "latexdesk.spell.dictionaryPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "Folder with more Hunspell dictionaries named `<lang>.aff` and `<lang>.dic`, for example `de_DE.aff`."
          },
          "latexdesk.spell.words": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Your own dictionary: words that are always accepted."
          },
          "latexdesk.spell.skipCommands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra commands whose first argument is not checked (e.g. \"code\" for \\code{...})."
          }
        }
      },
      {
        "title": "Toolbars",
        "properties": {
          "latexdesk.toolbar.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show the editing buttons (undo, compile, part, label, table, highlight, comment …) in the title bar of LaTeX editors."
          },
          "latexdesk.toolbar.showMiniBar": {
            "type": "boolean",
            "default": true,
            "description": "Open the LaTeX Tools mini bar (format, alignment, equations, symbols) when the first LaTeX file of a window is opened."
          }
        }
      }
    ],
    "submenus": [
      {
        "id": "latexdesk.partMenu",
        "label": "Part",
        "icon": {
          "light": "media/toolbar/part-light.svg",
          "dark": "media/toolbar/part-dark.svg"
        }
      },
      {
        "id": "latexdesk.labelMenu",
        "label": "Label",
        "icon": {
          "light": "media/toolbar/label-light.svg",
          "dark": "media/toolbar/label-dark.svg"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "gate:dissertation": "node esbuild.mjs && node scripts/dissertation-gate.mjs",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/esquaredsystems/latexdesk-resources/master/latexdesk --baseContentUrl https://github.com/esquaredsystems/latexdesk-resources/blob/master/latexdesk",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "jszip": "3.10.1",
    "mathjax-full": "3.2.2",
    "nspell": "2.1.5",
    "papaparse": "5.5.3",
    "pdfjs-dist": "4.10.38",
    "tree-kill": "1.2.2"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@types/nspell": "2.1.6",
    "@types/papaparse": "5.3.16",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.5",
    "eslint": "9.28.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vitest": "3.2.4"
  }
}
