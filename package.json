      "editor/context": [
        {
          "command": "latexdesk.syncForward",
          "when": "editorLangId == latex",
          "group": "latexdesk@1"
        },
        {
          "command": "latexdesk.wrapEnvironment",
          "when": "editorLangId == latex && editorHasSelection",
          "group": "latexdesk@2"
        },
        {
          "command": "latexdesk.citationBrowser",
          "when": "editorLangId == latex",
          "group": "latexdesk@3"
        },
        {
          "command": "latexdesk.openEntryForm",
